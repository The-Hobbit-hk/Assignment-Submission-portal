generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  DISTRICT_ADMIN
  DISTRICT_SECRETARY
  REPORTING_SECRETARY
  COUNCIL_MEMBER
  CLUB_PRESIDENT
  CLUB_SECRETARY
  MEMBER
}

enum ClubStatus {
  ACTIVE
  INACTIVE
  PROVISIONAL
}

enum MemberRole {
  PRESIDENT
  SECRETARY
  TREASURER
  DIRECTOR
  MEMBER
}

enum MemberStatus {
    ACTIVE
    INACTIVE
    ALUMNI
    PROSPECTIVE
  }

enum EventType {
  SERVICE
  PROFESSIONAL
  SOCIAL
  DISTRICT
  TRAINING
  ISD
  INSTALLATION
  PROFESSIONAL_DEVELOPMENT
  CLUB_SERVICE
  COMMUNITY_SERVICE
  INTERNATIONAL_SERVICE
  DEI
  PUBLIC_IMAGE
  ROTARY_RELATIONS
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BluebookSubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum CouncilEntityType {
  CLUB
  MEMBER
}

enum ActivityType {
  MEMBER_JOINED
  MEMBER_UPDATED
  EVENT_CREATED
  CLUB_CREATED
  DOCUMENT_UPLOADED
  LOGIN
}

enum MonthlyReportType {
  ADMIN
  EVENTS
}

enum MonthlyReportStatus {
  DRAFT
  SUBMITTED
}

enum CitationCadence {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum CitationAssignmentStatus {
  ASSIGNED
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum JobPostingStatus {
  OPEN
  CLOSED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  mustChangePassword Boolean @default(false)
  role          UserRole  @default(MEMBER)
  clubId        String?
  club          Club?     @relation("ClubLogin", fields: [clubId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  memberProfile            Member?
  clubsAsPresident         Club[]                      @relation("ClubPresident")
  clubsAsSecretary         Club[]                      @relation("ClubSecretary")
  activities               Activity[]
  bluebookSubmissions      BluebookSubmission[]        @relation("SubmissionReviewer")
  monthlyReports           MonthlyReport[]
  councilAssignments       CouncilBluebookAssignment[] @relation("CouncilAssignee")
  councilAssignmentsMade   CouncilBluebookAssignment[] @relation("CouncilAssignedBy")
  councilBluebookReports   CouncilBluebookReport[]     @relation("CouncilReportAssignee")
  councilReportsReviewed   CouncilBluebookReport[]     @relation("CouncilReportReviewer")
  citationsCreated         CitationDefinition[]        @relation("CitationCreator")
  citationsReviewed        CitationAssignment[]        @relation("CitationReviewer")
  jobPostingsCreated       JobPosting[]                @relation("JobCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Club {
  id            String     @id @default(cuid())
  name          String
  charterNumber String?    @unique
  city          String?
  zone          String?
  status        ClubStatus @default(ACTIVE)
  foundedAt     DateTime?
  description   String?    @db.Text
  logo          String?
  serviceHours  Int        @default(0)

  presidentId String?
  secretaryId String?
  president   User?   @relation("ClubPresident", fields: [presidentId], references: [id], onDelete: SetNull)
  secretary   User?   @relation("ClubSecretary", fields: [secretaryId], references: [id], onDelete: SetNull)

  members             Member[]
  events              Event[]
  bluebookSubmissions BluebookSubmission[]
  councilScores       CouncilScore[]
  monthlyReports      MonthlyReport[]
  clubLogins          User[]               @relation("ClubLogin")
  citationAssignments CitationAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, zone])
}

model CitationDefinition {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  points      Int
  cadence     CitationCadence
  createdById String
  createdBy   User            @relation("CitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  isActive    Boolean         @default(true)
  assignments CitationAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cadence, isActive])
}

model CitationAssignment {
  id              String                   @id @default(cuid())
  definitionId    String
  definition      CitationDefinition       @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  clubId          String
  club            Club                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  cadence         CitationCadence
  periodKey       String
  year            Int
  month           Int?
  quarter         Int?
  rotaryYearLabel String?
  dueDate         DateTime?
  status          CitationAssignmentStatus @default(ASSIGNED)
  proofUrl        String?
  clubNotes       String?                  @db.Text
  submittedAt     DateTime?
  reviewedById    String?
  reviewedBy      User?                    @relation("CitationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewerComment String?                  @db.Text
  awardedPoints   Int                      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([definitionId, clubId, periodKey])
  @@index([clubId, status])
  @@index([status])
  @@index([cadence, periodKey])
}

model JobPosting {
  id             String           @id @default(cuid())
  title          String
  company        String
  description    String           @db.Text
  location       String?
  recruiterName  String?
  recruiterEmail String
  status         JobPostingStatus @default(OPEN)
  createdById    String
  createdBy      User             @relation("JobCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model ReportingPeriod {
  id       String   @id @default(cuid())
  month    Int
  year     Int
  opensAt  DateTime
  closesAt DateTime
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
}

model MonthlyReport {
  id                      String              @id @default(cuid())
  type                    MonthlyReportType
  month                   Int
  year                    Int
  clubId                  String?
  club                    Club?               @relation(fields: [clubId], references: [id], onDelete: SetNull)
  submittedById           String?
  submittedBy               User?               @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  status                  MonthlyReportStatus @default(DRAFT)
  newMembers              Int?
  resolutionPassed        String?
  resolutionFileUrl       String?
  resolutionPassDate       DateTime?
  districtDuesPaid        String?
  districtDuesFileUrl     String?
  districtDuesMembersCount Int?
  districtDuesAmount       Int?
  bylawsPassed            String?
  bylawsFileUrl           String?
  bylawsPassDate          DateTime?
  masterBudgetPassed      String?
  masterBudgetFileUrl     String?
  masterBudgetPassDate    DateTime?
  hostClub                String?
  districtEventAttendance String?             @db.Text
  newsletterEvent         String?
  noEventsDeclared        Boolean             @default(false)
  submittedAt             DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([type, month, year])
  @@index([clubId])
}

model Member {
  id         String       @id @default(cuid())
  userId     String?      @unique
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  clubId     String
  club       Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  phone      String?
  role       MemberRole   @default(MEMBER)
  status     MemberStatus @default(ACTIVE)
  joinedAt   DateTime     @default(now())
  riId          String?
  profession    String?
  bio           String?      @db.Text
  avatar        String?
  /** Display-only home club for council members (they belong to the district council club for scoring). */
  homeClub      String?
  gender        String?
  dateOfBirth   DateTime?
  duesPaid      String?
  duesProofUrl  String?
  bloodGroup    String?
  whatsapp      String?
  points        Int          @default(0)

  activities          Activity[]
  eventRegistrations  EventRegistration[]
  councilScores       CouncilScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, clubId])
  @@index([clubId])
  @@index([status])
  @@index([role])
}

model Event {
  id            String      @id @default(cuid())
  title         String
  description   String?     @db.Text
  startDate     DateTime
  endDate       DateTime?
  location      String?
  hostedBy      String?
  collaborations String?    @db.Text
  type          EventType   @default(SERVICE)
  status        EventStatus @default(UPCOMING)
  clubId        String?
  club          Club?       @relation(fields: [clubId], references: [id], onDelete: SetNull)
  attendees     Int         @default(0)
  maxAttendees          Int?
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  registrationUrl       String?
  onSiteRegistration    Boolean     @default(false)
  serviceHours          Int         @default(0)
  budget                Decimal?    @db.Decimal(12, 2)
  bannerUrl             String?
  minutesPdfUrl         String?

  gallery              EventGallery[]
  registrations        EventRegistration[]
  publicRegistrations  PublicEventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId])
  @@index([startDate])
  @@index([status])
  @@index([type, startDate, status])
}

model PublicEventRegistration {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name             String
  clubName         String
  riId             String
  paymentProofPath String
  governmentIdPath String
  acknowledged     Boolean  @default(true)
  registeredAt     DateTime @default(now())

  @@unique([eventId, riId])
  @@index([eventId])
}

model EventGallery {
  id        String  @id @default(cuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
}

model EventRegistration {
  id           String             @id @default(cuid())
  eventId      String
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status       RegistrationStatus @default(CONFIRMED)
  registeredAt DateTime           @default(now())

  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
}

model BluebookTask {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  category    String
  maxScore    Int
  dueDate     DateTime
  month       Int
  year        Int
  isActive    Boolean  @default(true)

  submissions         BluebookSubmission[]
  councilAssignments  CouncilBluebookAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month, year])
  @@index([dueDate])
}

model BluebookCycle {
  id       String   @id @default(cuid())
  title    String
  month    Int
  year     Int
  opensAt  DateTime
  closesAt DateTime
  isActive Boolean  @default(true)

  reports CouncilBluebookReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
  @@index([closesAt])
}

model CouncilBluebookReport {
  id              String                   @id @default(cuid())
  cycleId         String
  cycle           BluebookCycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  assigneeId      String
  assignee        User                     @relation("CouncilReportAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  submissionNotes String?                  @db.Text
  proofUrls       Json                     @default("[]")
  status          BluebookSubmissionStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?                    @relation("CouncilReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewerComment String?                  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, assigneeId])
  @@index([assigneeId])
  @@index([status])
}

model CouncilBluebookAssignment {
  id              String                   @id @default(cuid())
  taskId          String
  task            BluebookTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assigneeId      String
  assignee        User                     @relation("CouncilAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedById    String
  assignedBy      User                     @relation("CouncilAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  proofUrl        String?
  allocatedScore  Int                      @default(0)
  reviewerComment String?                  @db.Text
  status          BluebookSubmissionStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  notes           String?                  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, assigneeId])
  @@index([assigneeId])
  @@index([status])
}

model BluebookSubmission {
  id              String                   @id @default(cuid())
  taskId          String
  task            BluebookTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clubId          String
  club            Club                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  proofUrl        String?
  allocatedScore  Int                      @default(0)
  reviewerComment String?                  @db.Text
  status          BluebookSubmissionStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?                    @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, clubId])
  @@index([clubId])
  @@index([status])
}

model CouncilScore {
  id         String            @id @default(cuid())
  entityType CouncilEntityType
  entityId   String
  clubId     String?
  club       Club?             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId   String?
  member     Member?           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  score      Int               @default(0)
  rank       Int?
  badge      String?
  trend      Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId, month, year])
  @@index([entityType, month, year])
  @@index([score])
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  title       String
  description String?
  metadata    Json?

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  clubId   String?
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
}
