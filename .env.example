# =============================================================================
# Rotaract District 3131 ERP — Environment Variables
# Copy to .env.local for development. Set the same keys in Vercel + Supabase.
# =============================================================================

# --- Supabase Postgres (Prisma) ---
# Project ref: xtojaphqdxdrrodskqar
#
# Vercel / runtime → Transaction pooler (port 6543, IPv4-compatible)
# Supabase → Database → Connect → "Transaction pooler"
DATABASE_URL="postgresql://postgres.xtojaphqdxdrrodskqar:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Local db:deploy only → pick ONE of the following:
#
# A) Direct (IPv6 only — Supabase shows "Not IPv4 compatible"):
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.xtojaphqdxdrrodskqar.supabase.co:5432/postgres"
#
# B) Session pooler (use this on most home/office IPv4 networks):
# Supabase → Database → Connect → "Session pooler"
DIRECT_URL="postgresql://postgres.xtojaphqdxdrrodskqar:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (required on Vercel — local disk is ephemeral) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xtojaphqdxdrrodskqar.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_UPLOAD_BUCKET="uploads"

# --- NextAuth / Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- App URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Submission windows (defaults OPEN for testing; set false to enforce 1st–10th rules) ---
# BYPASS_SUBMISSION_WINDOWS="false"

# =============================================================================
# Production (Vercel project: rotaractweb)
#   AUTH_URL=https://rotaractweb.vercel.app
#   NEXT_PUBLIC_APP_URL=https://rotaractweb.vercel.app
# =============================================================================

