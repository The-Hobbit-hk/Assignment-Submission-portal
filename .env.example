# =============================================================================
# Rotaract District 3131 ERP — Environment Variables
# Copy to .env.local for development. Set the same keys in Vercel + Supabase.
# =============================================================================

# --- Supabase Postgres (Prisma) ---
# Project ref: xtojaphqdxdrrodskqar
#
# Vercel / runtime → Transaction pooler (port 6543, IPv4-compatible)
# Supabase → Database → Connect → "Transaction pooler"
DATABASE_URL="postgresql://postgres.xtojaphqdxdrrodskqar:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Local db:deploy only → pick ONE of the following:
#
# A) Direct (IPv6 only — Supabase shows "Not IPv4 compatible"):
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.xtojaphqdxdrrodskqar.supabase.co:5432/postgres"
#
# B) Session pooler (use this on most home/office IPv4 networks):
# Supabase → Database → Connect → "Session pooler"
DIRECT_URL="postgresql://postgres.xtojaphqdxdrrodskqar:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (required on Vercel — local disk is ephemeral) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xtojaphqdxdrrodskqar.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_UPLOAD_BUCKET="uploads"

# --- NextAuth / Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- App URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google Calendar auto-sync for club installations (optional) ---
# Any event on this calendar whose title contains GOOGLE_CALENDAR_FILTER
# (default "installation") is pulled onto the public /calendar automatically,
# refreshing every few minutes. No Google Cloud project or OAuth needed.
#
# How to get the URL: open Google Calendar → Settings → click the calendar
# under "Settings for my calendars" → "Integrate calendar" → copy the
# "Secret address in iCal format" (ends in /basic.ics). Paste it below and in
# Vercel. Keep it secret — anyone with this link can read the calendar.
# GOOGLE_CALENDAR_ICS_URL="https://calendar.google.com/calendar/ical/xxxxx/private-xxxx/basic.ics"
# GOOGLE_CALENDAR_FILTER="installation"

# --- Submission windows (set false to enforce the 1st–10th reporting rules) ---
# Production default is ENFORCED (false). Only set true for testing.
# BYPASS_SUBMISSION_WINDOWS="false"

# --- Security / access ---
# Invite-only platform. Leave unset (or "false") in production so the public
# /register endpoint and page are disabled. Set "true" only if you intentionally
# want open self-signup.
# ALLOW_SELF_REGISTRATION="false"

# --- Seed credentials (used ONLY by db:seed / db:ensure-* scripts) ---
# Set STRONG, UNIQUE values before seeding production. Never commit real secrets.
# Rotate immediately after the first seed and require users to change them.
# SEED_ADMIN_EMAIL="admin@yourdomain.org"
# SEED_ADMIN_PASSWORD="set-a-strong-unique-password"
# SEED_COUNCIL_PASSWORD="set-a-strong-unique-password"

# =============================================================================
# Production (Vercel project: rotaractweb)
#   AUTH_URL=https://rotaractweb.vercel.app
#   NEXT_PUBLIC_APP_URL=https://rotaractweb.vercel.app
# =============================================================================
#
# IMPORTANT: This file is committed. Do NOT put real passwords/keys here.
# Default seed login EMAILS exist in code; their passwords come from the
# SEED_* env vars above. Any credentials that were ever committed to git
# history must be considered compromised and rotated.
