# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/load-test/.venv/
/load-test/report.html

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated login credentials (run npm run db:seed)
prisma/council-logins.csv

# generated exports / artifacts (may contain credentials)
/output

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated

# uploads
/public/uploads
/private-uploads

# local database / storage backups (contain PII + credential hashes — never commit)
/backups

# logo processing backups
/public/*.opaque-backup.png
